# Aegis Cloud Scanner - Environment Configuration
# IMPORTANT: Copy this to .env and update with your actual values
# DO NOT commit .env to version control!

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
PYTHONUNBUFFERED=1

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://aegis_user:CHANGE_PASSWORD@localhost:5432/aegis_scanner

# Database Password (for Docker deployment)
# Generate a secure random password for production
DB_PASSWORD=CHANGE_THIS_TO_SECURE_DB_PASSWORD

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Aegis Master Password (for encryption)
AEGIS_MASTER_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Domain Configuration
DOMAIN_NAME=aegis-scanner.ink

# Security Settings
DEBUG=False
TESTING=False

# Optional: Cloud Secrets Manager (for production)
# AWS_SECRETS_MANAGER_SECRET_NAME=aegis-production-secrets
# AWS_DEFAULT_REGION=ap-south-1
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# GCP_SECRET_MANAGER_PROJECT_ID=your-project-id
